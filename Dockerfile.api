FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

# used by docker-compose.override.yml
FROM deps AS development
COPY . .
RUN chmod +x ./apps/api/entrypoint.sh
EXPOSE 3001 9229
# Same entrypoint as production. Without it a fresh volume gives you an API that
# answers /health/ready with database:ok and then 500s on every query, because
# the dev command starts the server against whatever schema is already there.
# The compose override replaces CMD, not ENTRYPOINT, so migrate and seed still
# run first and then exec the dev command. Both are idempotent.
ENTRYPOINT ["./apps/api/entrypoint.sh"]
CMD ["pnpm", "--filter", "api", "dev"]

FROM deps AS build
COPY . .
RUN pnpm --filter shared build && pnpm --filter api build

FROM base AS production
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/drizzle ./apps/api/drizzle
COPY --from=build /app/apps/api/src ./apps/api/src
COPY apps/api/entrypoint.sh ./apps/api/
RUN chmod +x ./apps/api/entrypoint.sh && chown -R node:node /app

# The deploy runs migrate.ts and seed.ts as its own step before swapping any
# container, so the entrypoint must not repeat it. Declared on the image rather
# than injected at deploy time: an earlier version appended this to the
# instance's .env, that file had no trailing newline, and the append welded
# itself onto ENCRYPTION_KEY and took production down. The dev stage leaves it
# unset on purpose, so a plain `docker compose up` still migrates.
ENV MIGRATE_ON_START=false

USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1
ENTRYPOINT ["./apps/api/entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]
