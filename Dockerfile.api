FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --prod

# used by docker-compose.override.yml
FROM deps AS development
COPY . .
RUN chmod +x ./apps/api/entrypoint.sh
EXPOSE 3001 9229
# Same entrypoint as production. Without it a fresh volume gives you an API that
# answers /health/ready with database:ok and then 500s on every query, because
# the dev command starts the server against whatever schema is already there.
# The compose override replaces CMD, not ENTRYPOINT, so migrate and seed still
# run first and then exec the dev command. Both are idempotent.
ENTRYPOINT ["./apps/api/entrypoint.sh"]
CMD ["pnpm", "--filter", "api", "dev"]

FROM deps AS build
COPY . .
RUN pnpm --filter shared build && pnpm --filter api build

FROM base AS production
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# From prod-deps, not deps: the deps tree carries eslint, vitest and playwright,
# and copying it put roughly 2.5GB of build-only packages in the running image.
# Nothing in apps/ imports them, but they were still there to be scanned and
# shipped. Consequence worth knowing: this image has no tsx, so migrate.yml runs
# dist/db/migrate.js and not src/db/migrate.ts. Setting MIGRATE_ON_START=true
# here would fail on `tsx: not found` rather than migrate.
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=prod-deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/drizzle ./apps/api/drizzle
COPY apps/api/entrypoint.sh ./apps/api/
RUN chmod +x ./apps/api/entrypoint.sh && chown -R node:node /app

# The deploy runs migrate.ts and seed.ts as its own step before swapping any
# container, so the entrypoint must not repeat it. Declared on the image rather
# than injected at deploy time: an earlier version appended this to the
# instance's .env, that file had no trailing newline, and the append welded
# itself onto ENCRYPTION_KEY and took production down. The dev stage leaves it
# unset on purpose, so a plain `docker compose up` still migrates.
ENV MIGRATE_ON_START=false

# Declared because the image is built with --prod and is only coherent in
# production mode: lib/logger.ts sends pino through pino-pretty whenever
# NODE_ENV is not production, and pino-pretty is a devDependency that --prod
# correctly drops. entrypoint.sh reads this too, to pick the compiled migration
# over tsx.
ENV NODE_ENV=production

USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1
ENTRYPOINT ["./apps/api/entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]
