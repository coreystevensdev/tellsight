{
  "name": "tellsight",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check && pnpm type-check:scripts && pnpm type-check:e2e",
    "type-check:scripts": "pnpm turbo build --filter=shared && tsc --noEmit -p scripts/tsconfig.json",
    "type-check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "screenshots": "pnpm -C apps/api exec tsx ../../scripts/generate-screenshots.ts",
    "eval": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; pnpm -C apps/api exec tsx ../../scripts/eval-summaries.ts",
    "eval:qa": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; pnpm -C apps/api exec tsx ../../scripts/eval-qa.ts",
    "eval:proposals": "pnpm -C apps/api exec tsx ../../scripts/eval-proposal-precision.ts",
    "test:eval": "pnpm -C apps/api exec vitest run -c ../../scripts/vitest.config.ts",
    "test:integration": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; pnpm -C apps/api test:integration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "body-parser": ">=2.4.0",
      "multer": ">=2.5.0",
      "dompurify": ">=3.4.17"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jose": "^6.2.3",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "zod": "3.25.76"
  }
}
