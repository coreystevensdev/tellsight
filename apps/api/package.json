{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias && cp -r src/services/curation/config/. dist/services/curation/config/",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "tsx src/test/runIntegrationDatabasePreflight.ts && vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prometheus-io/client": "^0.16.1",
    "@react-email/render": "^2.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "^11.9.0",
    "bullmq": "^6.4.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "7.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.9.2",
    "resend": "^6.34.1",
    "shared": "workspace:*",
    "sharp": "0.35.5",
    "simple-statistics": "^7.12.1",
    "stripe": "^23.0.1",
    "svix": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
