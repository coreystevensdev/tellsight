{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // page.evaluate callbacks are compiled here but run in the browser, so this
    // needs DOM on top of whatever the base config sets for Node.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
