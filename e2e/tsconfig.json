{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // page.evaluate callbacks are compiled here but run in the browser, so this
    // needs DOM on top of whatever the base config sets for Node.
    "lib": ["ES2023", "DOM"],
    // Spelled out rather than relying on every @types package under node_modules
    // being picked up. TypeScript 6 stops doing that, and these specs use
    // process and Buffer directly.
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
